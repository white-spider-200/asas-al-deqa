# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public site origin used for canonical URLs, Open Graph, and sitemap references.
VITE_SITE_URL="https://adfta.com"

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=""

# SQLite database (relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# Blog admin auth
# Prefer a hashed password (never commit real secrets):
#   node scripts/hash-admin-password.mjs "your-strong-password-here"
# Then set ADMIN_PASSWORD_HASH and leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD="changeme-use-12-plus-chars"
ADMIN_PASSWORD_HASH=""
# Random secret for signing the admin session cookie (32+ chars in production)
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Set to 1 if the app runs behind nginx/Cloudflare (recommended in production)
TRUST_PROXY="1"

# Zoho SMTP for contact form emails
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER="info@adfta.com"
SMTP_PASS="YOUR_ZOHO_APP_PASSWORD"
CONTACT_TO="info@adfta.com"
